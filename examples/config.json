    },
    "claude": {
      "label": "Claude CLI",
      "command": "claude",
      "settingsArg": "--settings",
      "allowedProfiles": ["qianfan"]
    },
    "codex": {
      "label": "Codex CLI",
      "command": "codex"
    }
  }
}
